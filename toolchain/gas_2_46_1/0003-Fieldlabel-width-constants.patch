+      if (S_IS_DEFINED (width) || symbol_equated_p (width))
+	as_bad_where (file, line,
+		      _("field width symbol `%s' is already defined"),
+		      S_GET_NAME (width));
+      else
+	{
+	  S_SET_SEGMENT (width, absolute_section);
+	  S_SET_VALUE (width, size);
+	  symbol_set_frag (width, &zero_address_frag);
+	}
+    }
