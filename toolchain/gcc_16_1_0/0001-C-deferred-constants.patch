+#ifndef GCC_DEFERRED_CST_H
+#define GCC_DEFERRED_CST_H
+
+/* Returns true of accesses to fields of this type should be based on
+   deferred cst offsets.  This is the case on RECORD_TYPEs with
+
+     __attribute__((deferred_cst_access))  */
+extern bool deferred_cst_access_type_p (tree type);
+
+/* Returns true if FIELD is part of a type that satisfies
+   deferred_cst_access_type_p.  */
+extern bool deferred_cst_field_p (tree field);
+
+/* Return true if CODE is an operation which may be absorbed into a
+   DEFERRED_CST_EXPR.  */
+extern bool deferred_cst_operator_p (enum tree_code code);
+
+/* Build DEFERRED_CST_COMPONENT_REF to FIELD in BASE.  */
+extern tree deferred_cst_build_component_ref (tree type, tree base, tree field);
+
+/* Build a DEFERRED_CST_EXPR around EXPR.  */
+extern tree deferred_cst_build_expr (tree expr);
+
+/* Create a call to IFN_DEFERRED_CST_FIELD_OFFSET for the physical,
+   addressable FIELD whose byte offset is deferred.
+
+   FIELD must not be a bit-field.  Callers handling bit-fields must pass
+   DECL_BIT_FIELD_REPRESENTATIVE (field).  */
+extern tree deferred_cst_call_ifn_field_offset (location_t loc, tree field);
+
+/* Get the FIELD_DECL associated with the argument TOKEN to a call of
+   IFN_DEFERRED_CST_FIELD_OFFSET.  */
+extern tree deferred_cst_ifn_field_offset_field (tree token);
+
+/* Return true if EXPR contains a DEFERRED_CST_EXPR or
+   DEFERRED_CST_COMPONENT_REF.  */
+extern bool deferred_cst_present_p (tree expr);
+
+#endif
