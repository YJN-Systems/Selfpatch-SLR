index 00000000000..cc232066ea6
--- /dev/null
+++ b/gcc/deferred-cst.cc
@@ -0,0 +1,626 @@
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "stringpool.h"
+#include "fold-const.h"
+#include "internal-fn.h"
+#include "attribs.h"
+#include "tree-pass.h"
+#include "context.h"
+#include "cgraph.h"
+#include "function.h"
+#include "cfg.h"
+#include "basic-block.h"
+#include "gimple.h"
+#include "gimple-iterator.h"
+#include "gimple-walk.h"
+#include "diagnostic.h"
+
+#include "deferred-cst.h"
+
+/* Weak mapping from STRING_CST tokens used as arguments to
+   IFN_DEFERRED_CST_FIELD_OFFSET to the FIELD_DECL whose byte offset
+   the call represents.
+
+   For an ordinary field the value is that field's FIELD_DECL.
+
+   For a bit-field the value is DECL_BIT_FIELD_REPRESENTATIVE (field),
+   since IFN_DEFERRED_CST_FIELD_OFFSET describes the byte offset of
+   the whole bit-field representative rather than the individual
+   field.  */
+static GTY((cache)) tree_cache_map *field_offset_field_decls;
+
+/* Used only to make STRING_CST contents unique.  The actual string value has
+   no semantic meaning; the STRING_CST node itself is the metadata token.  */
+static unsigned HOST_WIDE_INT next_field_offset_token = 0;
+
+/* Return true if TYPE is a record carrying
+   __attribute__((deferred_cst_access)).  */
+bool
+deferred_cst_access_type_p (tree type)
+{
+  return (type
+	  && TREE_CODE (type) == RECORD_TYPE
+	  && lookup_attribute ("deferred_cst_access",
+			       TYPE_ATTRIBUTES (type)) != NULL_TREE);
+}
+
+bool
+deferred_cst_field_p (tree field)
+{
+  if (!field || TREE_CODE (field) != FIELD_DECL)
+    return false;
+
+  return deferred_cst_access_type_p (DECL_CONTEXT (field));
+}
+
+/* Return true if CODE is an operation which may be absorbed into a
+   DEFERRED_CST_EXPR.
+
+   This is deliberately an explicit whitelist.  In particular, do not
+   absorb arbitrary unary/binary/reference tree codes merely because all
+   of their operands happen to be constant.  */
+bool
+deferred_cst_operator_p (enum tree_code code)
+{
+  switch (code)
+    {
+    /* Binary arithmetic operations.  */
+    case PLUS_EXPR:
+    case MINUS_EXPR:
+    case MULT_EXPR:
+    case POINTER_PLUS_EXPR:
+    case POINTER_DIFF_EXPR:
+    case TRUNC_DIV_EXPR:
+    case CEIL_DIV_EXPR:
+    case FLOOR_DIV_EXPR:
+    case TRUNC_MOD_EXPR:
+    case RDIV_EXPR:
+    case EXACT_DIV_EXPR:
+    case LSHIFT_EXPR:
+    case RSHIFT_EXPR:
+    case LROTATE_EXPR:
+    case RROTATE_EXPR:
+    case BIT_IOR_EXPR:
+    case BIT_XOR_EXPR:
+    case BIT_AND_EXPR:
+      return true;
+
+    /* Comparisons.  */
+    case LT_EXPR:
+    case LE_EXPR:
+    case GT_EXPR:
+    case GE_EXPR:
+    case EQ_EXPR:
+    case NE_EXPR:
+    case UNORDERED_EXPR:
+    case ORDERED_EXPR:
+    case UNLT_EXPR:
+    case UNLE_EXPR:
+    case UNGT_EXPR:
+    case UNGE_EXPR:
+    case UNEQ_EXPR:
+      return true;
+
+    /* Boolean operations.
+
+       TRUTH_ANDIF_EXPR and TRUTH_ORIF_EXPR retain their short-circuit
+       semantics inside the deferred expression.  Nothing is evaluated
+       when absorbing expressions into deferred constants.  */
+    case TRUTH_AND_EXPR:
+    case TRUTH_OR_EXPR:
+    case TRUTH_XOR_EXPR:
+    case TRUTH_ANDIF_EXPR:
+    case TRUTH_ORIF_EXPR:
+      return true;
+
+    /* Unary arithmetic and conversions.  */
+    case FIX_TRUNC_EXPR:
+    case FLOAT_EXPR:
+    CASE_CONVERT:
+    case ADDR_SPACE_CONVERT_EXPR:
+    case NON_LVALUE_EXPR:
+    case NEGATE_EXPR:
+    case BIT_NOT_EXPR:
+    case TRUTH_NOT_EXPR:
+    case CONJ_EXPR:
+    case REALPART_EXPR:
+    case IMAGPART_EXPR:
+    case VIEW_CONVERT_EXPR:
+    case PAREN_EXPR:
+      return true;
+
+    case COMPLEX_EXPR:
+      return true;
+
+    /* Conditional expressions.  These are absorbed only when the
+       condition and both alternatives are all constant-like.  */
+    case COND_EXPR:
+    case VEC_COND_EXPR:
+      return true;
+
+    default:
+      return false;
+    }
+}
+
+tree
+deferred_cst_build_component_ref (tree type, tree base, tree field)
+{
+  gcc_assert (field);
+  gcc_assert (TREE_CODE (field) == FIELD_DECL);
+
+  return build2 (DEFERRED_CST_COMPONENT_REF, type, base, field);
+}
+
+tree
+deferred_cst_build_expr (tree expr)
+{
+  /* TODO assert that expr is actually a deferred constant  */
+  return build1_loc (EXPR_LOCATION (expr), DEFERRED_CST_EXPR,
+		     TREE_TYPE (expr), expr);
+}
+
+/* Create a unique STRING_CST to use as a metadata token.  */
+static tree
+make_token (const char *name, unsigned HOST_WIDE_INT id)
+{
+  char buf[128];
+
+  int len = snprintf (buf, sizeof (buf),
+		      "__deferred_cst_token_%s_"
+		      HOST_WIDE_INT_PRINT_UNSIGNED,
+		      name, id);
+
+  gcc_assert (len > 0);
+  gcc_assert ((unsigned int) len < sizeof (buf));
+
+  /* Include the trailing NUL.  */
+  unsigned int string_len = len + 1;
+
+  tree token = build_string (string_len, buf);
+
+  TREE_TYPE (token)
+    = build_array_type_nelts (char_type_node, string_len);
+
+  return token;
+}
+
+/* Generate a new key token into field_offset_field_decls and store
+   the FIELD_DECL FIELD under it.  Return the new token.  */
+static tree
+register_field_offset_field_decl (tree field)
+{
+  tree token = make_token ("field_offset", next_field_offset_token++);
+
+  if (!field_offset_field_decls)
+    field_offset_field_decls = tree_cache_map::create_ggc ();
+
+  bool existed = field_offset_field_decls->put (token, field);
+
+  /* Every token created above is unique.  */
+  gcc_assert (!existed);
+
+  return token;
+}
+
+/* Look up the field declaration associated with a token argument of
+   IFN_DEFERRED_CST_FIELD_OFFSET.  */
+static tree
+lookup_field_offset_field_decl (tree token)
+{
+  if (!token)
+    return NULL_TREE;
+
+  tree *slot
+    = field_offset_field_decls
+      ? field_offset_field_decls->get (token)
+      : NULL;
+
+  return slot ? *slot : NULL_TREE;
+}
+
+/* Create a call to IFN_DEFERRED_CST_FIELD_OFFSET for the physical,
+   addressable FIELD whose byte offset is deferred.
+
+   FIELD must not be a bit-field.  Callers handling bit-fields must pass
+   DECL_BIT_FIELD_REPRESENTATIVE (field).
+
+   Internally, these call hold the field declarations in a side-map
+   keyed by tokens used as call arguments.  */
+tree
+deferred_cst_call_ifn_field_offset (location_t loc, tree field)
+{
+  gcc_assert (field);
+  gcc_assert (TREE_CODE (field) == FIELD_DECL);
+  gcc_assert (!DECL_BIT_FIELD (field));
+
+  tree token = register_field_offset_field_decl (field);
+
+  return build_call_expr_internal_loc (loc,
+				       IFN_DEFERRED_CST_FIELD_OFFSET,
+				       sizetype, 1, token);
+}
+
+tree
+deferred_cst_ifn_field_offset_field (tree token)
+{
+  if (!token)
+    return NULL_TREE;
+
+  return lookup_field_offset_field_decl (token);
+}
+
+static tree
+find_deferred_cst_node (tree *tp, int *walk_subtrees, void *)
+{
+  tree node = *tp;
+
+  if (!node)
+    return NULL_TREE;
+
+  switch (TREE_CODE (node))
+    {
+    case DEFERRED_CST_EXPR:
+    case DEFERRED_CST_COMPONENT_REF:
+      *walk_subtrees = 0;
+      return node;
+
+    default:
+      break;
+    }
+
+  /* Declarations and types are metadata here. Do not walk into their
+     contexts, types, or initializers.  */
+  if (DECL_P (node) || TYPE_P (node))
+    *walk_subtrees = 0;
+
+  return NULL_TREE;
+}
+
+bool
+deferred_cst_present_p (tree expr)
+{
+  if (!expr)
+    return false;
+
+  tree root = expr;
+
+  return walk_tree_without_duplicates (
+	   &root,
+	   find_deferred_cst_node,
+	   NULL)
+	 != NULL_TREE;
+}
+
+/* Replace deferred cst components under DEFERRED_CST_EXPR nodes with
+   their compile-time values.
+
+   Calls to IFN_DEFERRED_CST_FIELD_OFFSET become the compile-time
+   field offsets.
+
+   Return NULL_TREE if no operation took place.  ICE if a substitution
+   failed.  */
+static tree
+substitute_deferred_cst_component (tree expr)
+{
+  if (!expr)
+    return NULL_TREE;
+
+  location_t loc = EXPR_LOCATION (expr);
+
+  if (TREE_CODE (expr) == CALL_EXPR)
+    {
+      if (CALL_EXPR_IFN (expr) == IFN_DEFERRED_CST_FIELD_OFFSET)
+	{
+	  gcc_assert (call_expr_nargs (expr) == 1);
+	  tree field
+	    = deferred_cst_ifn_field_offset_field (
+			    CALL_EXPR_ARG (expr, 0));
+
+	  gcc_assert (field && TREE_CODE (field) == FIELD_DECL);
+
+	  tree offset = byte_position (field);
+	  return fold_convert_loc (loc, TREE_TYPE (expr), offset);
+	}
+    }
+
+  return NULL_TREE;
+}
+
+/* Replace all deferred cst components with their compile-time values
+   and return the fully folded result.  */
+static tree
+substitute_deferred_cst_components (tree expr)
+{
+  if (CONSTANT_CLASS_P (expr))
+    return expr;
+
+  tree deferred_component = substitute_deferred_cst_component (expr);
+  if (deferred_component)
+    return deferred_component;
+
+  gcc_assert (deferred_cst_operator_p (TREE_CODE (expr)));
+
+  switch (TREE_OPERAND_LENGTH (expr))
+    {
+    case 1:
+      {
+	tree op0
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 0));
+
+	return fold_build1_loc (EXPR_LOCATION (expr),
+				TREE_CODE (expr),
+				TREE_TYPE (expr),
+				op0);
+      }
+
+    case 2:
+      {
+	tree op0
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 0));
+	tree op1
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 1));
+
+	return fold_build2_loc (EXPR_LOCATION (expr),
+				TREE_CODE (expr),
+				TREE_TYPE (expr),
+				op0, op1);
+      }
+
+    case 3:
+      {
+	tree op0
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 0));
+	tree op1
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 1));
+	tree op2
+	  = substitute_deferred_cst_components (TREE_OPERAND (expr, 2));
+
+	return fold_build3_loc (EXPR_LOCATION (expr),
+				TREE_CODE (expr),
+				TREE_TYPE (expr),
+				op0, op1, op2);
+      }
+
+    default:
+      gcc_unreachable ();
+    }
+}
+
+/* Replace all deferred components in EXPR with their compile-time
+   values and evaluate the result.  Return an actual constant.  */
+static tree
+evaluate_deferred_cst_now (tree expr)
+{
+  tree result = substitute_deferred_cst_components (expr);
+  result = fold (result);
+
+  if (!CONSTANT_CLASS_P (result))
+    internal_error ("invalid compile-time value of deferred constant");
+
+  return result;
+}
+
+/* Returns true if the given tree node may not exist past the deferred
+   constant barrier pass.  */
+static bool
+deferred_cst_barrier_applies (tree node)
+{
+  if (!node)
+    return false;
+
+  switch (TREE_CODE (node))
+    {
+    case DEFERRED_CST_EXPR:
+    case DEFERRED_CST_COMPONENT_REF:
+      return true;
+
+    default:
+      return false;
+    }
+}
+
+/* On the deferred constant barrier pass, return the replacement for
+   a tree node that may not exist beyond it.
+
+   DEFERRED_CST_COMPONENT_REFs are simpy replaced with a standard
+   COMPONENT_REF node.
+
+   All deferred components under a DEFERRED_CST_EXPR are replaced with
+   their actual compile-time values.  Afterwards, the expression is
+   fully evaluated to replace NODE.  */
+static tree
+deferred_cst_barrier_apply (tree node)
+{
+  gcc_assert (deferred_cst_barrier_applies (node));
+
+  if (flag_deferred_cst_barrier_hard)
+    internal_error (
+      "unresolved deferred constant reached hard barrier");
+
+  switch (TREE_CODE (node))
+    {
+    case DEFERRED_CST_EXPR:
+      return evaluate_deferred_cst_now (TREE_OPERAND (node, 0));
+
+    case DEFERRED_CST_COMPONENT_REF:
+      {
+	tree ref
+	  = build3_loc (EXPR_LOCATION (node),
+			COMPONENT_REF,
+			TREE_TYPE (node),
+			TREE_OPERAND (node, 0),
+			TREE_OPERAND (node, 1),
+			NULL_TREE);
+
+	/* Preserve expression properties that may have been attached
+	   to the deferred reference during lowering.  */
+	TREE_READONLY (ref) = TREE_READONLY (node);
+	TREE_THIS_VOLATILE (ref) = TREE_THIS_VOLATILE (node);
+	TREE_SIDE_EFFECTS (ref) = TREE_SIDE_EFFECTS (node);
+
+	return ref;
+      }
+
+    default:
+      gcc_unreachable ();
+    }
+}
+
+/* Walker to go through functions and initializers.  It applies the
+   deferred constant barrier to all deferred constant tree nodes.  */
+static tree
+deferred_cst_barrier_walk (tree *tp, int *walk_subtrees, void *data)
+{
+  tree node = *tp;
+
+  if (!node)
+    return NULL_TREE;
+
+  if (TYPE_P (node) || DECL_P (node))
+    {
+      *walk_subtrees = 0;
+      return NULL_TREE;
+    }
+
+  if (!deferred_cst_barrier_applies (node))
+    return NULL_TREE;
+
+  /*
+     A deferred component can have another deferred component in its base.
+     Clean the base explicitly before replacing the outer node.  Operand 1
+     is a FIELD_DECL and must not be walked.
+  */
+  if (TREE_CODE (node) == DEFERRED_CST_COMPONENT_REF)
+    {
+      tree base = TREE_OPERAND (node, 0);
+
+      walk_tree (&base,
+		 deferred_cst_barrier_walk,
+		 data,
+		 NULL);
+
+      TREE_OPERAND (node, 0) = base;
+    }
+
+  *tp = deferred_cst_barrier_apply (node);
+  *walk_subtrees = 0;
+
+  return NULL_TREE;
+}
+
+static void
+deferred_cst_barrier_function (function *fn)
+{
+  basic_block bb;
+
+  FOR_EACH_BB_FN (bb, fn)
+    {
+      for (gimple_stmt_iterator gsi = gsi_start_bb (bb);
+	   !gsi_end_p (gsi);
+	   gsi_next (&gsi))
+	{
+	  gimple *stmt = gsi_stmt (gsi);
+
+	  for (unsigned int i = 0; i < gimple_num_ops (stmt); ++i)
+	    {
+	      tree *operand = gimple_op_ptr (stmt, i);
+
+	      if (!operand || !*operand)
+		continue;
+
+	      walk_tree (operand,
+			 deferred_cst_barrier_walk,
+			 NULL,
+			 NULL);
+	    }
+	}
+    }
+}
+
+static tree
+deferred_cst_barrier_init (tree init)
+{
+  if (!init)
+    return init;
+
+  walk_tree (&init, deferred_cst_barrier_walk, NULL, NULL);
+
+  return init;
+}
+
+static void
+deferred_cst_barrier_functions ()
+{
+  cgraph_node *node;
+
+  FOR_EACH_FUNCTION_WITH_GIMPLE_BODY (node)
+    {
+      function *fn = DECL_STRUCT_FUNCTION (node->decl);
+      gcc_assert (fn);
+
+      push_cfun (fn);
+      deferred_cst_barrier_function (fn);
+      pop_cfun ();
+    }
+}
+
+static void
+deferred_cst_barrier_inits ()
+{
+  varpool_node *vnode;
+
+  FOR_EACH_VARIABLE (vnode)
+    {
+      tree decl = vnode->decl;
+      tree init = DECL_INITIAL (decl);
+
+      if (!init || init == error_mark_node)
+	continue;
+
+      tree clean_init = deferred_cst_barrier_init (init);
+      if (clean_init != init)
+	DECL_INITIAL (decl) = clean_init;
+    }
+}
+
+namespace {
+
+const pass_data pass_data_deferred_cst_barrier =
+{
+  SIMPLE_IPA_PASS,
+  "deferred-cst-barrier",
+  OPTGROUP_NONE,
+  TV_NONE,
+  0, 0, 0, 0, 0
+};
+
+class pass_deferred_cst_barrier : public simple_ipa_opt_pass
+{
+public:
+  pass_deferred_cst_barrier (gcc::context *ctxt)
+    : simple_ipa_opt_pass (pass_data_deferred_cst_barrier, ctxt)
+  {}
+
+  unsigned int execute (function *) final override;
+};
+
+unsigned int
+pass_deferred_cst_barrier::execute (function *)
+{
+  deferred_cst_barrier_functions ();
+  deferred_cst_barrier_inits ();
+  return 0;
+}
+
+} // anonymous namespace
+
+simple_ipa_opt_pass *
+make_pass_deferred_cst_barrier (gcc::context *ctxt)
+{
+  return new pass_deferred_cst_barrier (ctxt);
+}
+
+#include "gt-deferred-cst.h"
