+/* Internal helper for c_fully_fold.  Fold surrounding constant
+   operations into DEFERRED_CST_EXPR nodes.
+
+   An operation is absorbed when:
+
+     - its tree code is explicitly supported by
+       deferred_cst_operator_p;
+     - every operand is constant-like; and
+     - at least one operand is a DEFERRED_CST_EXPR.
+
+   Existing deferred wrappers are removed when an operation is absorbed,
+   giving a single outer DEFERRED_CST_EXPR.  For example:
+
+       DEFERRED_CST_EXPR (A) + 1
+	 -> DEFERRED_CST_EXPR (A + 1)
+
+       (DEFERRED_CST_EXPR (A) + 1) * 2
+	 -> DEFERRED_CST_EXPR ((A + 1) * 2)
+
+       DEFERRED_CST_EXPR (A) + DEFERRED_CST_EXPR (B)
+	 -> DEFERRED_CST_EXPR (A + B)
+
+       DEFERRED_CST_EXPR (C) ? 1 : 2
+	 -> DEFERRED_CST_EXPR (C ? 1 : 2)
+
+   An operation involving a nonconstant operand is not absorbed:
+
+       X + DEFERRED_CST_EXPR (A)
+	 -> X + DEFERRED_CST_EXPR (A)  */
+
+static tree
+c_fully_fold_deferred_cst_internal (tree expr)
+{
+  if (expr == NULL_TREE)
+    return NULL_TREE;
+
+  enum tree_code code = TREE_CODE (expr);
+
+  /* The true constants inside deferred constants can be folded here,
+     while the deferred components are represented as calls to
+     internal functions and thus can not and should not be folded
+     here.  */
+  if (code == DEFERRED_CST_EXPR)
+  {
+    tree old_inner = TREE_OPERAND (expr, 0);
+
+    bool maybe_const_operands = true;
+    bool maybe_const_itself = true;
+
+    tree inner
+      = c_fully_fold_internal (old_inner, false,
+			       &maybe_const_operands,
+			       &maybe_const_itself,
+			       false, false);
+
+    if (inner == old_inner)
+      return expr;
+
+    return deferred_cst_build_expr (inner);
+  }
+
+  /* Unsupported operations form a boundary for deferred folding.  */
+  if (!deferred_cst_operator_p (code))
+    return expr;
+
+  int nops = TREE_OPERAND_LENGTH (expr);
+
+  /* Every currently-supported operator has at most three operands.  */
+  gcc_assert (nops >= 1 && nops <= 3);
+
+  tree ops[3];
+  bool changed = false;
+  bool has_deferred = false;
+  bool all_constant = true;
+  bool has_side_effects = false;
+
+  for (int i = 0; i < nops; ++i)
+    {
+      tree old_op = TREE_OPERAND (expr, i);
+      tree op = c_fully_fold_deferred_cst_internal (old_op);
+
+      ops[i] = op;
+
+      if (op != old_op)
+	changed = true;
+
+      if (TREE_CODE (op) == DEFERRED_CST_EXPR)
+	has_deferred = true;
+      else if (!TREE_CONSTANT (op))
+	all_constant = false;
+
+      if (TREE_SIDE_EFFECTS (op))
+	has_side_effects = true;
+    }
+
+  /* There is no deferred expression directly participating in this
+     operation, or there are non-constant operands or operands with
+     side effects involved, so the operation itself must not become
+     deferred.
+
+     We may nevertheless need to propagate a transformation made in one
+     of the operands.  */
+  if (!has_deferred || !all_constant || has_side_effects)
+    {
+      if (!changed)
+	return expr;
+
+      tree copy = copy_node (expr);
+      for (int i = 0; i < nops; i++)
+	TREE_OPERAND (copy, i) = ops[i];
+
+      return copy;
+    }
+
+  /* Every operand is constant-like and at least one operand is
+     deferred.  Move this complete operation inside one deferred
+     wrapper.  */
+
+  tree inner = copy_node (expr);
+  for (int i = 0; i < nops; i++)
+    {
+      bool op_deferred_cst = ops[i] != NULL_TREE
+			     && TREE_CODE (ops[i]) == DEFERRED_CST_EXPR;
+      TREE_OPERAND (inner, i) = op_deferred_cst
+				? TREE_OPERAND (ops[i], 0) : ops[i];
+    }
+
+  bool maybe_const_operands = true;
+  bool maybe_const_itself = true;
+
+  /* The true constants inside deferred constants can be folded here,
+     while the deferred components are represented as calls to
+     internal functions and thus can not and should not be folded
+     here.  */
+  inner = c_fully_fold_internal (inner, false,
+				 &maybe_const_operands,
+				 &maybe_const_itself,
+				 false, false);
+
+  return deferred_cst_build_expr (inner);
+}
