@@ -7346,6 +7395,48 @@ fold_offsetof (tree expr, tree type, enum tree_code ctx)
     return size_binop (PLUS_EXPR, base, convert (type, off));
   return fold_build_pointer_plus (base, off);
 }
+
+/* Like fold_offsetof_internal, but integrates deferred constant components
+   into the result.  If such components exist, the result is wrapped in a
+   DEFERRED_CST_EXPR node.  */
+
+tree
+fold_offsetof (tree expr, tree type, enum tree_code ctx)
+{
+  tree res = NULL_TREE;
+  tree non_cst = NULL_TREE;
+  tree deferred = NULL_TREE;
+  tree cst = fold_offsetof_internal (expr, type, ctx, &non_cst, &deferred);
+
+  res = cst;
+
+  if (res == error_mark_node)
+    return res;
+
+  /* DEFERRED_CST_EXPRs contain only ordinary constants and deferred
+     constant components.  */
+  if (deferred != NULL_TREE)
+    {
+      if (POINTER_TYPE_P (type))
+	res = fold_build_pointer_plus (res, convert (sizetype, deferred));
+      else
+	res = size_binop (PLUS_EXPR, res, convert (type, deferred));
+
+      res = deferred_cst_build_expr (res);
+    }
+
+  /* Runtime-dependent terms are added only after the deferred
+     boundary has been constructed.  */
+  if (non_cst != NULL_TREE)
+    {
+      if (POINTER_TYPE_P (type))
+	res = fold_build_pointer_plus (res, convert (type, non_cst));
+      else
+	res = size_binop (PLUS_EXPR, res, convert (type, non_cst));
+    }
+
+  return res;
+}
 
