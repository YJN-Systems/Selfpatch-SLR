+      if (S_IS_DEFINED (label) || symbol_equated_p (label))
+	as_bad_where (file, line,
+		      _("field label `%s' is already defined"),
+		      S_GET_NAME (label));
+      else
+	{
+	  S_SET_SEGMENT (label, now_seg);
+	  S_SET_VALUE (label, field_start - frag_now->fr_literal);
+	  symbol_set_frag (label, frag_now);
+	}
     }
 
