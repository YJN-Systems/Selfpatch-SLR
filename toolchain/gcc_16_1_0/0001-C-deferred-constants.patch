+/* Helper for fold_offsetof_internal.  Add OFFSET to the ACCUMULATOR
+   tree.  */
+static void
+accumulate_offset (tree *accumulator, tree offset)
+{
+  gcc_assert (accumulator);
+  gcc_assert (offset);
+
+  offset = convert (sizetype, offset);
+
+  if (*accumulator == NULL_TREE)
+    *accumulator = offset;
+  else
+    *accumulator = size_binop_loc (
+      input_location, PLUS_EXPR, *accumulator, offset);
